<component name="ProjectRunConfigurationManager">
  <!-- The plain application with only the four shipments from data.sql:
       the generated ones are switched off here. Authentication is on;
       log in with joao / logistics2026. -->
  <configuration default="false" name="App" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.jgomes.logistics.LogisticsApplication" />
    <module name="logistics" />
    <envs>
      <env name="APP_SEED_BULK_SHIPMENTS" value="0" />
    </envs>
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
